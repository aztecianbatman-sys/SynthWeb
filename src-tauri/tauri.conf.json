{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synth Browser",
  "version": "0.1.0",
  "identifier": "space.synth.browser",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Synth Browser",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Browser",
    "shortDescription": "A quiet, fast desktop browser.",
    "longDescription": "Synth Browser is a Rust and Tauri desktop browser with a modular browser runtime boundary and Cortis search layer.",
    "copyright": "Synth Browser Contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE"
  }
}
